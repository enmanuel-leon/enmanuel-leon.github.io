{
  // Static site served from the repository root. Source-only files are excluded
  // through .assetsignore so they never become public URLs.
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "portfolio",
  "compatibility_date": "2026-11-17",
  "assets": {
    "directory": "./",
    "not_found_handling": "404-page"
  },
  "previews": {}
}
